<Window x:Class="Orion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:Orion.Views"
        xmlns:local="clr-namespace:Orion.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Title="ORION"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Storyboard x:Key="BackgroundAnimation" RepeatBehavior="Forever" AutoReverse="True">
      <PointAnimation Storyboard.TargetName="MainGradient" Storyboard.TargetProperty="StartPoint" From="0,0" To="1,1" Duration="0:0:8" />
      <PointAnimation Storyboard.TargetName="MainGradient" Storyboard.TargetProperty="EndPoint" From="1,1" To="0,0" Duration="0:0:10" />
      <DoubleAnimation Storyboard.TargetName="Glow01" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-100" To="900" Duration="0:0:14" AutoReverse="True"/>
      <DoubleAnimation Storyboard.TargetName="Glow01" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-100" To="500" Duration="0:0:18" AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="Glow02" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="200" To="-800" Duration="0:0:20" AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="Glow02" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="100" To="-500" Duration="0:0:16" AutoReverse="True" />
    </Storyboard>
  </Window.Resources>
  <Grid x:Name="Root" ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush x:Name="MainGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#001D39" Offset="0" />
        <GradientStop Color="#4E8EA2" Offset="0.45" />
        <GradientStop Color="#001D39" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#35001D39" BorderBrush="#504E8EA2" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
          <Ellipse x:Name="OrionName" Width="8" Height="8" Fill="#4E8EA2" Margin="0,0,8,0" />
          <TextBlock Text="ORION" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <view:CognitiveCoreView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border Grid.Row="1" ClipToBounds="True">
      <Canvas x:Name="TickerCanvas" ClipToBounds="True">
        <StackPanel x:Name="TickerContent" Orientation="Horizontal" Canvas.Top="11">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="TickerTransform" X="0"/>
          </StackPanel.RenderTransform>
          <TextBlock Text="AGENT 01 - ONLINE" Foreground="#4E8EA2" Margin="0,0,45,0"/>
          <TextBlock Text="ORCHESTRATOR  READY" Foreground="White" Margin="0,0,45,0" />
          <TextBlock Text="AGENT 04  PROCESSING" Foreground="#4E8EA2" Margin="0,0,45,0" />
          <TextBlock Text="MISSION 0001  RUNNING" Foreground="White" Margin="0,0,45,0" />
          <TextBlock Text="SYSTEM  NORMAL" Foreground="#4E8EA2" Margin="0,0,45,0" />
        </StackPanel>
      </Canvas>
    </Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="—" Width="45" Height="42" Background="Transparent" Foreground="White" BorderThickness="0" Click="Minimize_Click" />
      <Button Content="□" Width="45" Height="42" Background="Transparent" Foreground="White" BorderThickness="0" Click="Maximize_Click" />
      <Button Content="×" Width="45" Height="42" Background="Transparent" Foreground="White" BorderThickness="0" Click="Close_Click" />
    </StackPanel>
    <Ellipse x:Name="Glow01" Width="700" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-250,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#904E8EA2" Offset="0" />
          <GradientStop Color="#004E8EA2" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.RenderTransform>
        <TranslateTransform />
      </Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="Glow02" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-350" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#70001D39" Offset="0" />
          <GradientStop Color="#00001D39" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.RenderTransform>
        <TranslateTransform />
      </Ellipse.RenderTransform>
    </Ellipse>
  </Grid>
</Window>
